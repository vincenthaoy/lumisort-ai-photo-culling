# OpenAI-compatible vision endpoint. Leave empty to use the built-in portfolio demo mode.
DEEPSEEK_API_KEY=
DEEPSEEK_VISION_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp

# Tencent CloudBase Web configuration (safe to expose to the browser).
# Never put Tencent Cloud SecretId/SecretKey here.
NEXT_PUBLIC_TCB_ENV_ID=
NEXT_PUBLIC_TCB_REGION=ap-shanghai
NEXT_PUBLIC_TCB_PUBLISHABLE_KEY=
